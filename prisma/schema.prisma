generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int            @id @default(autoincrement())
  name              String
  email             String         @unique
  password          String
  avatar            String?
  saldo             Int            @default(0)
  pin               Int?
  histories         History[]
  refreshTokens     RefreshToken[]
  transaksiDiterima Transaksi[]    @relation("Penerima")
  transaksiDikirim  Transaksi[]    @relation("Pengirim")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @db.VarChar(255)
  userId    Int
  createdAt DateTime @default(now())
  expiredAt DateTime
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "RefreshToken_userId_fkey")
}

model Transaksi {
  id           Int       @id @default(autoincrement())
  pengirimId   Int
  penerimaId   Int
  jumlahDonasi Int
  pesanDonasi  String?
  waktu        DateTime  @default(now())
  histores     History[]
  penerima     User      @relation("Penerima", fields: [penerimaId], references: [id])
  pengirim     User      @relation("Pengirim", fields: [pengirimId], references: [id])

  @@index([penerimaId], map: "Transaksi_penerimaId_fkey")
  @@index([pengirimId], map: "Transaksi_pengirimId_fkey")
}

model History {
  id          Int             @id @default(autoincrement())
  userId      Int
  jumlah      Int
  jenis       JenisTransaksi
  sumber      SumberTransaksi
  transaksiId Int?
  waktu       DateTime        @default(now())
  transaksi   Transaksi?      @relation(fields: [transaksiId], references: [id])
  user        User            @relation(fields: [userId], references: [id])

  @@index([transaksiId], map: "History_transaksiId_fkey")
  @@index([userId], map: "History_userId_fkey")
}

enum JenisTransaksi {
  PEMASUKAN
  PENGELUARAN
}

enum SumberTransaksi {
  TOPUP
  PENARIKAN
  DONASI
}
